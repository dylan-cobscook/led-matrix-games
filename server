import time
import socket
import wifi

WIFI_SSID = "Cobscook Sharing"
WIFI_PASSWORD = "CBsharing23"


def connect_wifi():
    print("Connecting to WiFi...")
    wifi.radio.connect(WIFI_SSID, WIFI_PASSWORD)
    print("Connected to:", WIFI_SSID)
    print("IP address:", wifi.radio.ipv4_address)


connect_wifi()

HOST = str(wifi.radio.ipv4_address)
PORT = 80

server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.bind((HOST, PORT))
server.listen(5)

print("Listening for web requests at http://%s/" % HOST)

while True:
    try:
        client, client_address = server.accept()
        print("Connection from:", client_address)

        request = client.recv(2048)
        print(request.decode("utf-8", "replace"))

        html = (
            "<!DOCTYPE html>"
            "<html><body>"
            "<h1>Hello, world!</h1>"
            "<p>Matrix Portal web server is running.</p>"
            "</body></html>"
        )

        response = (
            "HTTP/1.1 200 OK\r\n"
            "Content-Type: text/html; charset=utf-8\r\n"
            "Connection: close\r\n\r\n"
            + html
        )

        client.send(response.encode("utf-8"))
        client.close()
    except OSError as exc:
        print("Socket error:", exc)
        time.sleep(1)
